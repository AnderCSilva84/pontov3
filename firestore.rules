rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return signedIn() && exists(userDocPath()) && get(userDocPath()).data.get('ativo', true) != false;
    }

    function userDoc() {
      return get(userDocPath()).data;
    }

    function isAdmin() {
      return userExists() && userDoc().role == "admin";
    }

    function myFuncionarioId() {
      return userExists() ? userDoc().funcionarioId : null;
    }

    function myFuncionarioDocPath() {
      return /databases/$(database)/documents/funcionarios/$(myFuncionarioId());
    }

    function myFuncionarioExists() {
      return userExists() && myFuncionarioId() != null && exists(myFuncionarioDocPath());
    }

    function myFuncionarioDoc() {
      return get(myFuncionarioDocPath()).data;
    }

    function myLocaisPermitidos() {
      return myFuncionarioExists() && myFuncionarioDoc().locaisPermitidos is list
        ? myFuncionarioDoc().locaisPermitidos
        : [];
    }

    // USERS
    match /users/{uid} {
      allow read: if signedIn() && (isAdmin() || request.auth.uid == uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        userExists() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken']) &&
        request.resource.data.fcmToken is string && request.resource.data.fcmToken.size() <= 4096
      );
    }

    // FUNCIONARIOS
    match /funcionarios/{funcionarioId} {
      allow read: if signedIn() && (isAdmin() || myFuncionarioId() == funcionarioId);
      allow write: if isAdmin();
    }

    match /filiais/{filialId} {
      allow read, write: if isAdmin();
    }

    // Conclusões diárias das tarefas da rotina fixa.
    match /funcionarios/{funcionarioId}/conclusoesRotina/{conclusaoId} {
      allow read: if signedIn() && (isAdmin() || myFuncionarioId() == funcionarioId);
      allow create: if signedIn() && (
        isAdmin() ||
        (
          myFuncionarioId() == funcionarioId &&
          request.resource.data.keys().hasOnly(['tarefaId', 'dataKey', 'concluidaEm', 'concluidaPor']) &&
          request.resource.data.concluidaEm == request.time &&
          conclusaoId == request.resource.data.dataKey + '_' + request.resource.data.tarefaId &&
          exists(/databases/$(database)/documents/tarefasSemanais/$(request.resource.data.tarefaId)) &&
          request.resource.data.concluidaPor == funcionarioId &&
          request.resource.data.tarefaId is string &&
          request.resource.data.dataKey is string
        )
      );
      allow update, delete: if false;
    }

    // LOCAIS (GPS)
    match /locais/{localId} {
      allow read: if signedIn() && (
        isAdmin() ||
        (myFuncionarioExists() && localId in myLocaisPermitidos())
      );
      allow write: if isAdmin();
    }

    // REGISTROS (log do ponto)
    match /registros/{id} {
      allow read: if signedIn() &&
        (isAdmin() || resource.data.funcionarioId == myFuncionarioId());

      allow create: if isAdmin();

      allow update, delete: if isAdmin();
    }

    // DIAS (resumo do ponto)
    match /dias/{id} {
      allow read: if signedIn() &&
        (isAdmin() || resource.data.funcionarioId == myFuncionarioId());

      allow create, update: if isAdmin();

      allow delete: if isAdmin();
    }

    // CATÁLOGO DE COMPRAS (lista de itens da casa)
    match /catalogoCompras/{itemId} {
      allow read: if userExists();
      allow write: if false; // Validação e escrita pelas funções de compras.
    }

    match /categoriasCompras/{id} {
      allow read: if userExists();
      allow write: if false;
    }
    match /supermercados/{id} {
      allow read: if userExists();
      allow write: if false;
    }
    match /comprasListas/{listaId} {
      allow read: if userExists();
      allow write: if false;
      match /itens/{itemId} {
        allow read: if userExists();
        allow write: if false;
      }
    }
    match /comprasPrecos/{id} {
      allow read, write: if false; // Apenas backend e relatório autenticado.
    }

    // LISTA DE COMPRAS ATIVA
    match /listaCompras/{itemId} {

      // todos logados podem ver
      allow read: if signedIn();

      // funcionária pode solicitar itens
      allow create: if signedIn() && !exists(/databases/$(database)/documents/comprasListas/legado-v1) &&
        (isAdmin() || request.resource.data.solicitadoPor == myFuncionarioId());

      // admin atualiza tudo; funcionária altera apenas sua própria solicitação
      allow update: if signedIn() && !exists(/databases/$(database)/documents/comprasListas/legado-v1) && (
        isAdmin() ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'solicitado', 'comprado', 'solicitadoPor', 'solicitadoPorNome', 'criadoEm'
          ]) &&
          myFuncionarioExists() &&
          (resource.data.solicitadoPor == myFuncionarioId() || resource.data.solicitado == false) &&
          request.resource.data.solicitadoPor == myFuncionarioId() &&
          request.resource.data.comprado == false
        )
      );

      // apenas admin pode apagar
      allow delete: if isAdmin() && !exists(/databases/$(database)/documents/comprasListas/legado-v1);
    }

    // TAREFAS
    match /tarefas/{tarefaId} {
      allow read: if signedIn();

      // só admin cria tarefas
      allow create: if isAdmin();

      // admin pode atualizar tudo; funcionária só pode concluir
      allow update: if signedIn() && (
        isAdmin() ||
        (
          resource.data.concluida == false &&
          myFuncionarioExists() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['concluida', 'concluidaEm', 'concluidaPor']) &&
          request.resource.data.concluidaPor == myFuncionarioId() &&
          request.resource.data.concluidaEm == request.time &&
          request.resource.data.concluida == true &&
          request.resource.data.titulo == resource.data.titulo &&
          request.resource.data.diaSemana == resource.data.diaSemana &&
          request.resource.data.dataAgendada == resource.data.dataAgendada &&
          request.resource.data.solicitadoPor == resource.data.solicitadoPor &&
          request.resource.data.solicitadoPorNome == resource.data.solicitadoPorNome
        )
      );

      allow delete: if isAdmin();
    }

    match /tarefasSemanais/{tarefaId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // NOTIFICAÇÕES — alterações publicadas pelo Admin para a funcionária
    match /notificacoes/{notificacaoId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Assinaturas e recibos de push são gerenciados somente pelas Cloud Functions.
    match /pushDispositivos/{id} {
      allow read, write: if false;
    }
    match /pushEnvios/{id} {
      allow read, write: if false;
    }
    match /pushEventos/{id} {
      allow read, write: if false;
    }

    match /financeiro/{lancamentoId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /financeiroAuditoria/{registroId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /documentosTrabalhistas/{documentoId} {
      allow read, write: if isAdmin();
    }

    match /folhasPagamento/{folhaId} {
      allow read, write: if isAdmin();
    }

    // AJUSTES DE PONTO (LOG)
    match /ajustesPonto/{ajusteId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

  }
}
