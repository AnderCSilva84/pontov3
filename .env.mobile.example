# Copie para .env.mobile.local (ignorado). Sem configuração explícita o build falha.
VITE_AP1303_DESTINO=emuladores
# Android emulador: 10.0.2.2; iOS simulador/web: 127.0.0.1; aparelho: IP LAN do PC.
VITE_EMULATOR_HOST=127.0.0.1
# Este exemplo é para CELULAR USB com adb reverse nas portas 9098, 8877 e 5007.
# Para Android Emulator, trocar explicitamente para 10.0.2.2.
# Alternativa: destino=teste + todas as VITE_TEST_FIREBASE_* de projeto dedicado.
# Não copie VITE_FIREBASE_* de produção para estas chaves.
# VITE_TEST_FIREBASE_PROJECT_ID=ap1303-teste-exemplo
# VITE_TEST_FIREBASE_API_KEY=chave-publica-do-projeto-de-teste
# VITE_TEST_FIREBASE_AUTH_DOMAIN=ap1303-teste-exemplo.firebaseapp.com
# VITE_TEST_FIREBASE_APP_ID=id-publico-app-de-teste
# VITE_TEST_FIREBASE_STORAGE_BUCKET=ap1303-teste-exemplo.firebasestorage.app
# VITE_TEST_FIREBASE_MESSAGING_SENDER_ID=id-publico-de-teste
# Android com FCM real e dados locais: destino=teste, mesmo PROJECT_ID real
# no cliente, google-services.json e CLI dos três emuladores.
# Exige autorização/configuração dedicada; não usa o projeto demo-ap1303.
# VITE_TEST_FIREBASE_EMULADORES=true
# VITE_EMULATOR_HOST=127.0.0.1
